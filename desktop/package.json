{
  "name": "litpage-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Litpage for Windows: the workspace app with its server bundled, or as a client for a server you host.",
  "author": "Litpage contributors",
  "license": "MIT",
  "main": "src/main.mjs",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "start": "electron .",
    "test": "node --test test/",
    "pack": "node scripts/bundle.mjs --runtime win-x64 && electron-builder --win --x64 --dir",
    "dist": "node scripts/bundle.mjs --runtime win-x64 && electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "app.litpage.desktop",
    "productName": "Litpage",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "src/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/server",
        "to": "server"
      },
      {
        "from": "build/runtime",
        "to": "runtime"
      },
      {
        "from": "build/licenses",
        "to": "licenses"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Litpage-Setup-${version}.${ext}"
    },
    "publish": null
  }
}
